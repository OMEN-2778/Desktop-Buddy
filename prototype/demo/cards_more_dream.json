[
 {
  "n": 3101,
  "title": "房顶那么高",
  "text": "梦里，{名字}骑着自行车一蹬就飞了起来，可最高只能飞到房顶。",
  "at": "home",
  "on": "dream",
  "when": "sleeping",
  "a": {
   "label": "继续往上蹬。",
   "out": [
    {
     "text": "越过烟囱的时候，风里全是刚烤好的面包味。",
     "mood": {
      "name": "烟囱上的面包香",
      "emo": "happy",
      "pts": 2,
      "min": 120
     }
    },
    {
     "text": "链条突然掉了，车子悬在半空慢慢转起圈来。",
     "mood": {
      "name": "半空转圈",
      "emo": "dazed",
      "pts": 2,
      "min": 120
     }
    }
   ]
  },
  "b": {
   "label": "先停在屋顶歇歇。",
   "out": [
    {
     "text": "屋顶上有只猫递来一杯热茶，说它在这儿等了一晚上。",
     "mood": {
      "name": "屋顶的热茶",
      "emo": "happy",
      "pts": 2,
      "min": 120
     }
    },
    {
     "text": "瓦片忽然变成滑梯，{名字}连人带车一路出溜下去。",
     "mood": {
      "name": "瓦片滑梯",
      "emo": "scared",
      "pts": 2,
      "min": 120
     }
    }
   ]
  }
 },
 {
